{
  "description": "Malformed inputs the logic must reject loudly (RangeError), never coerce.",
  "cases": [
    {
      "case_id": "invalid-001",
      "name": "malformed due date",
      "terms": {
        "principal": 100000,
        "currency": "USD",
        "dueDate": "2026-7-1",
        "graceDays": 5,
        "accrualBasis": "FROM_GRACE_EXPIRY",
        "chargeKind": "ANNUAL_RATE",
        "rateOrAmount": 9,
        "capKind": "PCT_OF_REFERENCE",
        "capValue": 5
      },
      "event": {
        "paidDate": "2026-07-21",
        "amountPaid": 100000
      },
      "expectErrorMatch": "invalid ISO date"
    },
    {
